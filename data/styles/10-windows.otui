Window < UIWindow
  font: verdana-11px-antialised
  size: 200 200
  opacity: 1
  color: #dfdfdf
  text-offset: 0 2
  text-align: top
  image-source: /images/ui/window
  image-border: 6
  image-border-top: 27
  padding-top: 36
  padding-left: 16
  padding-right: 16
  padding-bottom: 16

  $disabled:
    color: #dfdfdf88

  $dragging:
    opacity: 0.8

HeadlessWindow < UIWindow
  image-source: /images/ui/window_headless
  image-border: 5
  padding: 5

NewWindow < UIWindow
  font: Verdana Bold-11px
  size: 200 200
  color: #909090
  text-offset: -2 1
  image-source: /images/ui/popupwindow
  image-border: 4
  image-border-top: 17
  padding-top: 17
  padding-left: 4
  padding-right: 4
  padding-bottom: 4
  display-sound: 2785

NewMainWindow < NewWindow
  anchors.centerIn: parent

MainWindow < Window
  anchors.centerIn: parent
  
StaticWindow < Window
  draggable: false

StaticMainWindow < StaticWindow
  anchors.centerIn: parent

MainWindowContent < UIWidget
  id: content
  anchors.fill: parent
  padding: 20 28 20 28

NewWindow < UIWindow
  font: Verdana Bold-11px
  size: 200 200
  color: #909090
  text-offset: -2 1
  image-source: /images/ui/popupwindow
  image-border: 4
  image-border-top: 17
  padding-top: 17
  padding-left: 4
  padding-right: 4
  padding-bottom: 4
  display-sound: 2785

NewHeadlessWindow < UIWindow
  image-source: /images/ui/3pixel-frame-borderimage
  image-border: 5
  anchors.centerIn: parent

ActionAssignWindow < MainWindow
  id: assignWindow
  size: 400 215
  font: Verdana Bold-11px
  color: #909090
  text-offset: 0 2

  Label
    id: chatMode
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 130
    margin-top: -7
    text-auto-resize: true
    text: Mode: "Chat On"
    font: Verdana Bold-11px
    color: #c0c0c0

  FlatLabel
    id: display
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 33
    margin-top: 10
    text-align: center
    font: Verdana Bold-11px
    color: #c0c0c0

  Label
    id: desc
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    margin-left: -1
    text-auto-resize: true 
    text-wrap: true
    text: Click "Ok" to assign the hotkey. Click "Clear" to remove the hotkey from "
    font: Verdana Bold-11px
    color: #c0c0c0

  Label
    id: warning
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 5
    text-auto-resize: true
    text: This hotkey is already in use and will be overwritten.
    color: #f75f5f
    font: Verdana Bold-11px
    visible: false

  HorizontalSeparator
    anchors.top: prev.bottom
    margin-top: 10
    anchors.left: parent.left
    anchors.right: parent.right

  Button
    id: buttonClose
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 45 21
    font: cipsoftFont
    text: Close
    @onClick: self:getParent():destroy()

  Button
    id: buttonClear
    anchors.right: prev.left
    margin-right: 5
    anchors.bottom: parent.bottom
    size: 45 21
    font: cipsoftFont
    text: Clear

  Button
    id: buttonOk
    anchors.right: prev.left
    margin-right: 5
    anchors.bottom: parent.bottom
    size: 45 21
    font: cipsoftFont
    text: Ok