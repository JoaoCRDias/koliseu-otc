  // Bottom buttons
  Button
    id: btnSave
    !text: tr('Save')
    width: 80
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-bottom: 5
    margin-right: 5
    @onClick: modules.game_helper.tools.imbuementScrollSettingsOnSave()
  Button
    id: btnClose
    !text: tr('Close')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 5
    margin-right: 5
    @onClick: self:getParent():hide()
