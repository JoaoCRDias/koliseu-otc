ImbuementScrollSettingsWindow < MainWindow
  !text: tr('Imbuement Scroll Settings')
  size: 330 560
  @onEscape: self:hide()

  ScrollablePanel
    id: scrollContent
    anchors.fill: parent
    anchors.bottom: next.top
    margin-bottom: 5
    margin-top: 30
    vertical-scrollbar: scrollBar

    VerticalScrollBar
      id: scrollBar
      width: 12
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 14
      pixels-scroll: true

    Panel
      id: scrollPresets
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 1600

      // Preset 0
      Label
        id: scroll0Label
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Scroll 1')
        font: verdana-11px-antialised
        color: #dfdfdf
        text-auto-resize: true
        margin-top: 5
        margin-left: 5
      UIButton
        id: imbuementScrollGearButton0
        size: 34 34
        anchors.top: scroll0Label.bottom
        anchors.left: parent.left
        margin-top: 3
        margin-left: 5
        image-source: /images/game/actionbar/actionbarslot
        @onClick: modules.game_helper.tools.assignImbuementScrollItem(0)
        @onMousePress: |
          if mouseButton == MouseRightButton then
            local menu = g_ui.createWidget('PopupMenu')
            menu:setGameMenu(true)
            menu:addOption(tr('Select item'), function() modules.game_helper.tools.assignImbuementScrollItem(0) end)
            menu:addOption(tr('Remove'), function() modules.game_helper.tools.removeImbuementScrollItem(0) end)
            menu:display(mousePos)
            return true
          end
      CheckBox
        id: imbuementScroll0helmet
        width: 88
        anchors.top: imbuementScrollGearButton0.top
        anchors.left: imbuementScrollGearButton0.right
        margin-left: 6
        !text: tr('Helmet')
        font: verdana-11px-antialised
        color: #dfdfdf
        text-offset: 13 0
        change-cursor-image: false
      CheckBox
        id: imbuementScroll0armor
        width: 88
        anchors.top: imbuementScroll0helmet.bottom
        anchors.left: imbuementScrollGearButton0.right
        margin-left: 6
        margin-top: 2
        !text: tr('Armor')
        font: verdana-11px-antialised
        color: #dfdfdf
        text-offset: 13 0
        change-cursor-image: false
      CheckBox
        id: imbuementScroll0weapon
        width: 88
        anchors.top: imbuementScroll0armor.bottom
        anchors.left: imbuementScrollGearButton0.right
        margin-left: 6
        margin-top: 2
        !text: tr('Weapon')
        font: verdana-11px-antialised
        color: #dfdfdf
        text-offset: 13 0
        change-cursor-image: false
      CheckBox
        id: imbuementScroll0shield
        width: 88
        anchors.top: imbuementScroll0weapon.bottom
        anchors.left: imbuementScrollGearButton0.right
        margin-left: 6
        margin-top: 2
        !text: tr('Shield')
        font: verdana-11px-antialised
        color: #dfdfdf
        text-offset: 13 0
        change-cursor-image: false
      CheckBox
        id: imbuementScroll0ammo
        width: 88
        anchors.top: imbuementScroll0helmet.top
        anchors.left: imbuementScroll0helmet.right
        margin-left: 10
        !text: tr('Ammo')
        font: verdana-11px-antialised
        color: #dfdfdf
        text-offset: 13 0
        change-cursor-image: false
      CheckBox
        id: imbuementScroll0backpack
        width: 88
        anchors.top: imbuementScroll0ammo.bottom
        anchors.left: imbuementScroll0ammo.left
        margin-top: 2
        !text: tr('Backpack')
        font: verdana-11px-antialised
        color: #dfdfdf
        text-offset: 13 0
        change-cursor-image: false
      CheckBox
        id: imbuementScroll0boots
        width: 88
        anchors.top: imbuementScroll0backpack.bottom
        anchors.left: imbuementScroll0ammo.left
        margin-top: 2
        !text: tr('Boots')
        font: verdana-11px-antialised
        color: #dfdfdf
        text-offset: 13 0
        change-cursor-image: false
      HorizontalSeparator
        anchors.top: imbuementScroll0shield.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 3

      // Preset 1
      Label
        id: scroll1Label
        anchors.top: prev.bottom
        anchors.left: parent.left
