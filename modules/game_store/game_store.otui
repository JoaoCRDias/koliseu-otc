Box < UIWidget
  border-width-top: 1
  border-color-top: black
  border-width-left: 1
  border-color-left: black
  border-width-bottom: 1
  border-color-bottom: gray
  border-width-right: 1
  border-color-right: gray
  image-smooth: true
  image-fixed-ratio: false

HistoryEntry < UIWidget
  anchors.top: parent.top
  anchors.right: parent.right
  margin-right: 8
  margin-top: 24
  size: 535 15
  background-color: #404040

  Label
    id: historyDate
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3

  Label
    id: historyBalance
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 147

  Label
    id: historyDescription
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 242

RowStore < StoreLightFlatPanel
  height: 78
  margin: 2
  border: 0 white

  $focus:
    border: 2 white

  Box
    id: image
    size: 68 68
    anchors.top: parent.top
    anchors.left: parent.left
    margin: 5 0 0 5
    image-source: /game_store/images/panel_container
    image-border: 3

  Label
    id: lblName
    anchors.top: parent.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin: 8 8 0 8

    text-auto-resize: true
    text-wrap: true
  Panel
    id: StackOffers
    width: 150
    height: 80
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: -7
    margin-bottom: -2
    layout:
      type: grid
      cell-size: 145 20
      cell-spacing: 5
      flow: true
      fit-children: true

MenuCategoryStore < UIWidget
  height: 22
  image-source: images/longButton
  image-border: 5
  margin: 3
  image-clip: 0 0 166 22
  text-align: left
  text-offset: 25 0
  text-wrap: true
  icon-align: left
  icon-offset: 6 0
  font: verdana-11px-rounded

  $pressed:
    text-offset: 25 0

  $focus:
    image-clip: 0 22 166 22

StoreWindow
  size: 850 750
  !text: tr('Store')
  color: #909090
  visible: false
  @onEscape: modules.game_store.toggle()

  StoreButton
    id: btnClose
    size: 45 20
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    !text: tr('Close')
    font: cipsoftFont
    @onClick: modules.game_store.toggle()

  StoreButton
    id: btnHistory
    size: 45 20
    anchors.bottom: parent.bottom
    anchors.right: btnClose.left
    margin-right: 5
    !text: tr('History')
    font: cipsoftFont
    @onClick: modules.game_store.toggleTransferHistory()

  Panel
    id: lblCoins
    size: 260 20
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 2
    image-color: #1111118c
    focusable: false
    phantom: true
    image-source: /images/ui/button-9grid-pressed
    image-border: 3
    Label
      id: lblParenthesis
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr(")")
      focusable: false
      phantom: true
      font: verdana-11px-rounded
      color: #C0C0C0
      margin-right: 3
      margin-bottom: 1

    UIWidget
      id: iconodos
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      focusable: false
      phantom: true
      margin-right: 0
      margin-bottom: 2
      image-source: images/icon-tibiacointransferable

    Label
      id: lblTibiaTransfer
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      text-auto-resize: true
      margin-right: 2
      margin-bottom: 1
      font: verdana-11px-rounded
      color: #C0C0C0
      phantom: true

    UIWidget
      id: icono
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      margin-right: 2
      margin-bottom: 2
      image-source: /images/ui/tibiaCoin
      focusable: false
      phantom: true

    Label
      id: lblTibiaCoins
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      focusable: false
      margin-bottom: 1
      margin-right: 2
      font: verdana-11px-rounded
      color: #C0C0C0
      text-auto-resize: true
      phantom: true 

  StoreButton
    id: btnCoins
    size: 64 20
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    margin-left: 5
    margin-bottom: 2
    !tooltip: tr('Buy Tibia Coins via Pix')
    image-color: green
    icon: /images/ui/tibiaCoin
    icon-align: center
    icon-offset: 10 -1
    text-offset: -10 0
    !text: tr('Get')
    font: cipsoftFont
    @onClick: modules.game_store.buyViaPix()

    $pressed:
      text-offset: -18 0
      icon-offset: 10 0

  Button
    id: transferPoints
    anchors.top: btnCoins.top
    !tooltip: tr('Transfer Coins')
    anchors.left: btnCoins.right
    margin-left: 5
    icon-align: center
    icon-source: images/iconTransfer
    size: 64 20
    @onClick: modules.game_store.onGiftWindow()

  Button
    id: auctionCharacter
    anchors.top: transferPoints.top
    !tooltip: tr('Setup up an auction to sell you currents characters.')
    anchors.left: transferPoints.right
    margin-left: 5
    icon-align: center
    icon-source: images/icon-trade
    size: 64 20
    @onClick: modules.game_store.openBaazarWindow()

  HorizontalSeparator
    anchors.bottom: prev.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 8

  UIScrollArea
    id: listCategory
    size: 209 450
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: prev.top
    image-source: /images/ui/2pixel_up_frame_borderimage_dark
    image-border: 3
    auto-focus: none
    layout: verticalBox
    margin-bottom: 8
    padding: 5

  TextEdit
    id: SearchEdit
    anchors.bottom: listCategory.bottom
    anchors.left: parent.left
    margin-left: 5
    margin-bottom: 10
    height: 17
    width: 180
    placeholder: Type to search
    placeholder-color: #6E706F

  UIWidget
    id: SearchClearButton
    anchors.right: SearchEdit.right
    anchors.top: SearchEdit.top
    margin-top: 1
    margin-right: 2
    image-source: /game_cyclopedia/images/button_clear_search
    image-color: white
    opacity: 0.8
    enabled: false
    @onClick: modules.game_store.search()
    $hover !disabled:
      opacity: 1.0
      image-color: white
    $pressed:
      opacity: 1.0
      image-color: gray
    $disabled:
      opacity: 0.5

  StoreLightFlatPanel
    id: panelItem
    anchors.top: parent.top
    anchors.left: listCategory.right
    anchors.right: parent.right
    anchors.bottom: listCategory.bottom
    margin-left: 8

    padding: 6

    UIWidget
      id: comboBoxContainer
      height: 20
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      layout: horizontalBox
      margin-right:22
      QtComboBox
        id: showAll
        width: 260
        height: 20
        mouse-scroll: false

      QtComboBox
        id: MostPopularFirst
        width: 260
        margin-left: 12
        height: 20
        mouse-scroll: false

    UIScrollArea
      id: listProduct
      size: 286 407
      anchors.top: comboBoxContainer.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      vertical-scrollbar: scrollList
      image-source: /game_store/images/panel_container
      image-border: 3
      layout: verticalBox
      padding: 5
      margin-top:5
      auto-focus: none
    
    VerticalScrollBar
      id: scrollList
      anchors.top: listProduct.top
      anchors.bottom: listProduct.bottom
      anchors.left: listProduct.right
      step: 14
      pixels-scroll: true

    Label
      id: lblName
      anchors.top: comboBoxContainer.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-left: 140
      text-wrap: true
      text-auto-resize: true
      text-align: center
      text: Prismatic Unicorn
      margin-top:5

    Box
      id: image
      size: 124 124
      anchors.top: lblName.bottom
      anchors.left: scrollList.right
      margin: 8 0 0 8
      image-source: /game_store/images/panel_container
      image-border: 3

    Panel
      id: buyButtonsPanel
      anchors.top: prev.top
      anchors.left: prev.right
      anchors.right: parent.right
      margin-left: 10
      size: 145 70
      
      StoreButton
        id: btnBuy1
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 23
        !text: tr('Buy')
        font: cipsoftFont
        image-color: #75bfff
        visible: true
        enabled: true
        opacity: 1.0

      UIWidget
        id: lblPrice1
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 23
        margin-top: 3
        image-source: /images/ui/test/button-verydarkgrey-down
        image-border: 3
        visible: true
        phantom: false

        Label
          id: priceText
          anchors.verticalCenter: parent.verticalCenter
          anchors.horizontalCenter: parent.horizontalCenter
          margin-right: 8
          font: verdana-11px-antialised
          color: #C0C0C0
          text: 0
          text-auto-resize: true

        UIWidget
          id: priceIcon
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: priceText.right
          margin-left: 3
          size: 12 12
          image-source: /images/ui/tibiaCoin

      StoreButton
        id: btnBuy2
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
        height: 23
        !text: tr('Buy')
        font: cipsoftFont
        image-color: #75bfff
        visible: false
        enabled: true
        opacity: 1.0

      UIWidget
        id: lblPrice2
        anchors.top: btnBuy2.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 23
        margin-top: 3
        image-source: /images/ui/test/button-verydarkgrey-down
        image-border: 3
        visible: false
        phantom: false

        Label
          id: priceText
          anchors.verticalCenter: parent.verticalCenter
          anchors.horizontalCenter: parent.horizontalCenter
          margin-right: 8
          font: verdana-11px-antialised
          color: #C0C0C0
          text: 0
          text-auto-resize: true

        UIWidget
          id: priceIcon
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: priceText.right
          margin-left: 3
          size: 12 12
          image-source: /images/ui/tibiaCoin

    Panel
      id: descriptionPanel
      anchors.top: image.bottom
      anchors.left: scrollList.right
      anchors.right: parent.right
      anchors.bottom: scrollList.bottom
      margin-left: 8
      margin-top: 7
      image-source: /game_store/images/panel_flat
      image-border: 1
      padding: 5
      
      UIScrollArea
        id: descriptionScrollArea
        anchors.fill: parent
        vertical-scrollbar: descriptionScrollbar
        background-color: #404040
        margin: -3

        Label
          id: lblDescription
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: parent.top
          text-wrap: true
          text-auto-resize: true
          text-align: top
          text-vertical-auto-resize: true
          font: verdana-11px-rounded
          color: #F4F4F4
          margin: 0

      VerticalScrollBar
        id: descriptionScrollbar
        anchors.top: descriptionScrollArea.top
        anchors.bottom: descriptionScrollArea.bottom
        anchors.left: descriptionScrollArea.right
        margin-left: -4
        margin-top: -5
        margin-bottom: -6

  QtPanel
    id: transferHistory
    anchors.top: parent.top
    anchors.left: listCategory.right
    anchors.right: parent.right
    anchors.bottom: listCategory.bottom
    margin-left:10
    visible: false

    Panel
      id: historyPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-bottom: 22
      background-color: #363636
      border: 1 black
      layout:
        type: verticalBox

    Button
      id: btnNextPage
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-bottom:-5
      !text: tr('Next Page')
      @onClick: modules.game_store.requestTransactionHistory(self)

    Label
      id: lblPage
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Page 1 / 4')

    Button
      id: btnPrevPage
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-bottom:-5
      !text: tr('Prev Page')
      @onClick: modules.game_store.requestTransactionHistory(self)

  StoreLightFlatPanel
    id: HomePanel
    anchors.top: parent.top
    anchors.left: listCategory.right
    anchors.right: parent.right
    anchors.bottom: listCategory.bottom
    margin-left: 8
    padding: 6
    UIWidget
      id: HomeImagen
      size: 583 222
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-right:10

    UIButton
      id: prevImagen
      anchors.verticalCenter: prev.verticalCenter
      anchors.left: prev.left
      size: 16 29
      image-source: images/button-featured-offers-left
      margin-left: 15
      @onClick: modules.game_store.changeImagenHome(self:getId())
      $pressed :
        image-source: images/button-featured-offers-left-highlight
      $hover:
        image-source: images/button-featured-offers-left-highlight


    UIButton
      id: nextImagen
      anchors.verticalCenter: prev.verticalCenter
      anchors.right: HomeImagen.right
      size: 16 29
      margin-right: 15
      image-source: images/button-featured-offers-right
      @onClick: modules.game_store.changeImagenHome(self:getId())
      $pressed:
        image-source: images/button-featured-offers-right-highlight
      $hover:
        image-source: images/button-featured-offers-right-highlight

    MiniPanel
      id: HomePromotions
      anchors.top: HomeImagen.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 150
      margin-top: 5
      text: Promotions
      
      UIScrollArea
        id: HomeGoods
        anchors.fill: parent
        vertical-scrollbar: scrollPromo
        image-border: 3
        margin-right: 15
        layout:
          type: grid
          cell-size: 272 80
          cell-spacing: 5
          flow: true

      VerticalScrollBar
        id: scrollPromo
        anchors.top: HomeGoods.top
        anchors.bottom: HomeGoods.bottom
        anchors.left: HomeGoods.right
        step: 14
        pixels-scroll: true

    MiniPanel
      id:HomeRecentlyAdded
      anchors.top: HomePromotions.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      text: Recently Added
      
      UIScrollArea
        id: HomeProductos
        anchors.fill: parent
        vertical-scrollbar: scrollList2 
        image-border: 3
        margin-right: 15
        layout:
          type: grid
          cell-size: 272 80
          cell-spacing: 5
          flow: true

      
      VerticalScrollBar
        id: scrollList2
        anchors.top: HomeProductos.top
        anchors.bottom: HomeProductos.bottom
        anchors.left: HomeProductos.right
        step: 14
        pixels-scroll: true