HouseData < UIWidget
  height: 56
  image-source: /images/ui/miniwindow
  image-border: 4
  focusable: false
  UIWidget
    id: main
    anchors.fill: parent
    focusable: true
    text-align: top
    text-offset: 0 8
    font: verdana-11px-rounded
    color: #c0c0c0
    UIWidget
      id: imageOwnHouse
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 8
      margin-right: 3
      size: 12 12
      image-source: /images/game/cyclopedia/house/own-house
      visible: false
    Label
      id: sizeText
      !text: tr('Size:')
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 5
      margin-top: 23
      color: #909090
      font: verdana-11px-rounded
    Label
      id: sizeValueText
      anchors.left: prev.right
      anchors.top: prev.top
      margin-left: 3
      color: #c0c0c0
      font: verdana-11px-rounded
    Label
      id: maxBedsText
      !text: tr('Max. Beds:')
      anchors.left: sizeValueText.right
      anchors.top: sizeText.top
      margin-left: 15
      color: #909090
      font: verdana-11px-rounded
    Label
      id: maxBedsValueText
      anchors.left: prev.right
      anchors.top: prev.top
      margin-left: 3
      color: #c0c0c0
      font: verdana-11px-rounded
    Label
      id: rentText
      !text: tr('Rent:')
      anchors.left: maxBedsValueText.right
      anchors.top: sizeText.top
      margin-left: 15
      color: #909090
      font: verdana-11px-rounded
    Label
      id: rentValueText
      anchors.left: prev.right
      anchors.top: prev.top
      margin-left: 3
      color: #c0c0c0
      font: verdana-11px-rounded
    UIWidget
      id: rentGoldIcon
      anchors.left: prev.right
      anchors.verticalCenter: prev.verticalCenter
      margin-left: 2
      image-source: /game_cyclopedia/images/icon_gold
    Label
      id: statusText
      !text: tr('Status:')
      anchors.left: parent.left
      anchors.top: sizeText.bottom
      margin-left: 5
      margin-top: 3
      color: #909090
      font: verdana-11px-rounded
    Label
      id: statusValueText
      anchors.left: prev.right
      anchors.top: prev.top
      margin-left: 3
      color: #c0c0c0
      font: verdana-11px-rounded
    @onClick: modules.game_cyclopedia.Cyclopedia.House.onSelectHouse(self)

UIWidget
  id: Cat5
  anchors.fill: parent
  visible: false
  UIWidget
    id: checkboxBackground
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 52
    margin-top: 5
    image-source: /images/ui/2pixel_up_frame_borderimage
    image-border: 5
    ComboBox
      id: allStates
      size: 214 20
      color: #C0C0C0
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 7
      text-align: center
    ComboBox
      id: ownHouses
      size: 215 20
      color: #C0C0C0
      anchors.right: allStates.left
      anchors.top: allStates.top
      margin-right: 5
      text-align: center
    ComboBox
      id: sortName
      size: 215 20
      color: #C0C0C0
      anchors.left: allStates.right
      anchors.top: allStates.top
      margin-left: 5
      text-align: center
    CheckBoxCircle
      id: checkGuildhalls
      anchors.bottom: parent.bottom
      anchors.left: parent.horizontalCenter
      margin-bottom: 5
      margin-left: 20
      text-offset: 15 0
      !text: tr('Guildhalls')
      font: verdana-11px-rounded
      color: #C0C0C0
      size: 90 12
      @onClick: modules.game_cyclopedia.Cyclopedia.House.toggleHouseChecked(true)
    CheckBoxCircle
      id: checkHouses
      anchors.bottom: checkGuildhalls.bottom
      anchors.right: checkGuildhalls.left
      margin-right: 20
      text-offset: 15 0
      !text: tr('Houses and Flats')
      font: verdana-11px-rounded
      color: #C0C0C0
      size: 120 12
      @onClick: modules.game_cyclopedia.Cyclopedia.House.toggleHouseChecked(false)

  UIWidget
    id: mapViewBackground
    size: 250 358
    anchors.top: checkboxBackground.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-bottom: 8
    image-source: /images/ui/2pixel_up_frame_borderimage
    image-border: 5
    UIWidget
      id: minimapContainer
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 8
      height: 180
      image-source: /images/ui/panel_flat
      image-border: 4
      UIMinimap
        id: minimap
        anchors.fill: parent
        margin: 2
        min-zoom: 0
        max-zoom: 6
        visible: false
      UIWidget
        id: noSelectedBackground
        anchors.fill: parent
        margin: 2
        background-color: #000000
        Label
          id: noSelected
          !text: tr('No house selected')
          color: #C0C0C0
          anchors.centerIn: parent
          font: verdana-11px-rounded
    Panel
      id: panelTextsRents
      anchors.top: minimapContainer.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-left: 8
      margin-right: 8
      Label
        id: noBidHouseHeader
        !text: tr('Auction')
        anchors.top: parent.top
        anchors.left: parent.left
        color: #F7F7F7
        font: verdana-11px-rounded
        visible: false
      Label
        id: noBidHouseText
        !text: tr('There is no bid so far.\nBe the first to bid on this house.')
        anchors.top: noBidHouseHeader.bottom
        anchors.left: parent.left
        margin-top: 3
        color: #C0C0C0
        font: verdana-11px-rounded
        visible: false
      Panel
        id: bidInfo
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 80
        visible: false
        Label
          id: auctionLabel
          !text: tr('Auction')
          anchors.top: parent.top
          anchors.left: parent.left
          color: #F7F7F7
          font: verdana-11px-rounded
        Label
          id: bidderLabel
          !text: tr('Highest Bidder:')
          anchors.top: auctionLabel.bottom
          anchors.left: parent.left
          margin-top: 3
          color: #909090
          font: verdana-11px-rounded
        Label
          id: bidderName
          anchors.top: bidderLabel.top
          anchors.left: bidderLabel.right
          margin-left: 3
          color: #C0C0C0
          font: verdana-11px-rounded
        Label
          id: endLabel
          !text: tr('End Time:')
          anchors.top: bidderLabel.bottom
          anchors.left: parent.left
          margin-top: 2
          color: #909090
          font: verdana-11px-rounded
        Label
          id: endValue
          anchors.top: endLabel.top
          anchors.left: endLabel.right
          margin-left: 3
          color: #C0C0C0
          font: verdana-11px-rounded
        Label
          id: highestBidLabel
          !text: tr('Highest Bid:')
          anchors.top: endLabel.bottom
          anchors.left: parent.left
          margin-top: 2
          color: #909090
          font: verdana-11px-rounded
        Label
          id: highestBidValue
          anchors.top: highestBidLabel.top
          anchors.left: highestBidLabel.right
          margin-left: 3
          color: #C0C0C0
          font: verdana-11px-rounded
        UIWidget
          id: highestBidGold
          anchors.left: highestBidValue.right
          anchors.verticalCenter: highestBidValue.verticalCenter
          margin-left: 3
          image-source: /game_cyclopedia/images/icon_gold
        Label
          id: yourLimitLabel
          !text: tr('Your Bid Limit:')
          anchors.top: highestBidLabel.bottom
          anchors.left: parent.left
          margin-top: 2
          color: #909090
          font: verdana-11px-rounded
          visible: false
        Label
          id: yourLimitValue
          anchors.top: yourLimitLabel.top
          anchors.left: yourLimitLabel.right
          margin-left: 3
          color: #C0C0C0
          font: verdana-11px-rounded
          visible: false
        UIWidget
          id: yourLimitGold
          anchors.left: yourLimitValue.right
          anchors.verticalCenter: yourLimitValue.verticalCenter
          margin-left: 3
          image-source: /game_cyclopedia/images/icon_gold
          visible: false
      Panel
        id: rental
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 80
        visible: false
        UIWidget
          id: imageOwnHouseRental
          anchors.top: parent.top
          anchors.right: parent.right
          margin-top: 0
          margin-right: 0
          size: 12 12
          image-source: /images/game/cyclopedia/house/own-house
          visible: false
        Label
          id: rentalLabel
          !text: tr('Rental Details')
          anchors.top: parent.top
          anchors.left: parent.left
          color: #F7F7F7
          font: verdana-11px-rounded
        Label
          id: tenantLabel
          !text: tr('Tenant:')
          anchors.top: rentalLabel.bottom
          anchors.left: parent.left
          margin-top: 3
          color: #909090
          font: verdana-11px-rounded
        Label
          id: tenantValue
          anchors.top: tenantLabel.top
          anchors.left: tenantLabel.right
          margin-left: 3
          color: #C0C0C0
          font: verdana-11px-rounded
        Label
          id: paidLabel
          !text: tr('Paid Until:')
          anchors.top: tenantLabel.bottom
          anchors.left: parent.left
          margin-top: 2
          color: #909090
          font: verdana-11px-rounded
        Label
          id: paidValue
          anchors.top: paidLabel.top
          anchors.left: paidLabel.right
          margin-left: 3
          color: #C0C0C0
          font: verdana-11px-rounded
        Button
          id: moveButton
          !text: tr('Move Out')
          size: 64 20
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          margin-bottom: 5
          visible: false
        Button
          id: transferButton
          !text: tr('Transfer')
          size: 64 20
          anchors.bottom: parent.bottom
          anchors.right: moveButton.left
          margin-right: 5
          margin-bottom: 5
          visible: false
      Button
        id: bidButton
        !text: tr('Bid')
        size: 64 20
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-bottom: 5
        visible: false
        @onClick: modules.game_cyclopedia.Cyclopedia.House.onBidButton(self)

  UIWidget
    id: selectedBackground
    anchors.top: mapViewBackground.top
    anchors.left: mapViewBackground.right
    anchors.right: parent.right
    anchors.bottom: mapViewBackground.bottom
    margin-left: 5
    image-source: /images/ui/panel-1-pixel
    image-border: 4
    UIScrollArea
      id: panelHouse
      vertical-scrollbar: panelHouseScrollbar
      anchors.fill: parent
      margin-right: 13
      padding: 3
      layout:
        type: verticalBox
        spacing: 3
    VerticalScrollBar
      id: panelHouseScrollbar
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-right: 3
      margin-top: 3
      margin-bottom: 3
      step: 56
      pixel-scroll: true

  UIWidget
    id: bidHouseWindow
    anchors.top: mapViewBackground.top
    anchors.left: mapViewBackground.right
    anchors.right: parent.right
    anchors.bottom: mapViewBackground.bottom
    margin-left: 5
    image-source: /images/ui/panel_flat
    image-border: 4
    visible: false

    Label
      id: titleLabel
      !text: tr('Place Your Bid')
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 10
      margin-left: 10
      color: #F7F7F7
      font: verdana-11px-rounded

    Label
      id: houseInfoLabel
      !text: tr('House Information')
      anchors.top: titleLabel.bottom
      anchors.left: parent.left
      margin-top: 10
      margin-left: 10
      color: #F7F7F7
      font: verdana-11px-rounded

    Label
      id: nameLabel
      !text: tr('Name:')
      anchors.top: houseInfoLabel.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 10
      color: #909090
      font: verdana-11px-rounded
    Label
      id: nameValue
      anchors.top: nameLabel.top
      anchors.left: nameLabel.right
      margin-left: 5
      color: #C0C0C0
      font: verdana-11px-rounded

    Label
      id: sizeLabel
      !text: tr('Size:')
      anchors.top: nameLabel.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10
      color: #909090
      font: verdana-11px-rounded
    Label
      id: sizeValue
      anchors.top: sizeLabel.top
      anchors.left: sizeLabel.right
      margin-left: 5
      color: #C0C0C0
      font: verdana-11px-rounded

    Label
      id: bedsLabel
      !text: tr('Max. Beds:')
      anchors.top: sizeLabel.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10
      color: #909090
      font: verdana-11px-rounded
    Label
      id: bedsValue
      anchors.top: bedsLabel.top
      anchors.left: bedsLabel.right
      margin-left: 5
      color: #C0C0C0
      font: verdana-11px-rounded

    Label
      id: rentLabel
      !text: tr('Rent:')
      anchors.top: bedsLabel.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10
      color: #909090
      font: verdana-11px-rounded
    Label
      id: rentValue
      anchors.top: rentLabel.top
      anchors.left: rentLabel.right
      margin-left: 5
      color: #C0C0C0
      font: verdana-11px-rounded
    UIWidget
      id: rentGoldIcon
      anchors.left: rentValue.right
      anchors.verticalCenter: rentValue.verticalCenter
      margin-left: 2
      image-source: /game_cyclopedia/images/icon_gold

    Label
      id: auctionInfoLabel
      !text: tr('Auction Information')
      anchors.top: rentLabel.bottom
      anchors.left: parent.left
      margin-top: 10
      margin-left: 10
      color: #F7F7F7
      font: verdana-11px-rounded

    Panel
      id: thereFar
      anchors.top: auctionInfoLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 30
      margin-top: 5
      margin-left: 10
      visible: false
      Label
        id: noBidText
        !text: tr('There is no bid so far.\nBe the first to bid on this house.')
        anchors.top: parent.top
        anchors.left: parent.left
        color: #C0C0C0
        font: verdana-11px-rounded

    Panel
      id: currentAuction
      anchors.top: auctionInfoLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 60
      margin-top: 5
      margin-left: 10
      visible: false
      Label
        id: highestBidderLabel
        !text: tr('Highest Bidder:')
        anchors.top: parent.top
        anchors.left: parent.left
        color: #909090
        font: verdana-11px-rounded
      Label
        id: highestBidder
        anchors.top: highestBidderLabel.top
        anchors.left: highestBidderLabel.right
        margin-left: 5
        color: #C0C0C0
        font: verdana-11px-rounded
      Label
        id: endTimeLabel
        !text: tr('End Time:')
        anchors.top: highestBidderLabel.bottom
        anchors.left: parent.left
        margin-top: 2
        color: #909090
        font: verdana-11px-rounded
      Label
        id: endTime
        anchors.top: endTimeLabel.top
        anchors.left: endTimeLabel.right
        margin-left: 5
        color: #C0C0C0
        font: verdana-11px-rounded
      Label
        id: highestBidLabel
        !text: tr('Highest Bid:')
        anchors.top: endTimeLabel.bottom
        anchors.left: parent.left
        margin-top: 2
        color: #909090
        font: verdana-11px-rounded
      Label
        id: highestBid
        anchors.top: highestBidLabel.top
        anchors.left: highestBidLabel.right
        margin-left: 5
        color: #C0C0C0
        font: verdana-11px-rounded
      UIWidget
        id: highestBidGold
        anchors.left: highestBid.right
        anchors.verticalCenter: highestBid.verticalCenter
        margin-left: 2
        image-source: /game_cyclopedia/images/icon_gold
      Label
        id: yourLimitLabel
        !text: tr('Your Bid Limit:')
        anchors.top: highestBidLabel.bottom
        anchors.left: parent.left
        margin-top: 2
        color: #909090
        font: verdana-11px-rounded
        visible: false
      Label
        id: yourLimitValue
        anchors.top: yourLimitLabel.top
        anchors.left: yourLimitLabel.right
        margin-left: 5
        color: #C0C0C0
        font: verdana-11px-rounded
        visible: false
      UIWidget
        id: yourLimitGold
        anchors.left: yourLimitValue.right
        anchors.verticalCenter: yourLimitValue.verticalCenter
        margin-left: 2
        image-source: /game_cyclopedia/images/icon_gold
        visible: false

    Label
      id: limitText
      !text: tr('Your Bid Limit:')
      anchors.bottom: limitBox.top
      anchors.left: parent.left
      margin-left: 10
      margin-bottom: 5
      color: #909090
      font: verdana-11px-rounded

    TextEdit
      id: limitBox
      size: 150 20
      anchors.bottom: infoOrange.top
      anchors.left: parent.left
      margin-left: 10
      margin-bottom: 10
      color: #C0C0C0
      font: verdana-11px-rounded
      @onTextChange: modules.game_cyclopedia.Cyclopedia.House.onBidChangeValue(self)

    UIWidget
      id: infoOrange
      size: 9 9
      anchors.bottom: cancelBid.top
      anchors.left: parent.left
      margin-left: 10
      margin-bottom: 10
      image-source: /images/skin/show-gui-help-orange
      visible: false

    UIWidget
      id: infoRed
      size: 9 9
      anchors.bottom: cancelBid.top
      anchors.left: infoOrange.right
      margin-left: 5
      margin-bottom: 10
      image-source: /images/skin/show-gui-help-red
      visible: false

    Button
      id: cancelBid
      !text: tr('Cancel')
      size: 64 20
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-bottom: 10
      margin-right: 10
      @onClick: modules.game_cyclopedia.Cyclopedia.House.onCancelBidWindow()

    Button
      id: confirmBid
      !text: tr('Bid')
      size: 64 20
      anchors.bottom: parent.bottom
      anchors.right: cancelBid.left
      margin-right: 5
      margin-bottom: 10
      @onClick: modules.game_cyclopedia.Cyclopedia.House.onPlaceBid(self)
