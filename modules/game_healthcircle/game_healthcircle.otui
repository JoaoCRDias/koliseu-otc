LeftHealthCircle < UIWidget
  id: leftHealthCircle
  opacity: 0.3
  phantom: true

LeftHealthCircleFront < UIWidget
  id: leftHealthCircleFront
  opacity: 0.3
  phantom: true

RightHealthCircle < UIWidget
  id: rightHealthCircle
  opacity: 0.7
  phantom: true

RightHealthCircleFront < UIWidget
  id: rightHealthCircleFront
  opacity: 0.7
  phantom: true

SpecialConditions < UIWidget
  id: specialConditions
  width: 30
  opacity: 0.8
  phantom: true
  visible: false

  image-source: /images/arcs/hud-status
  image-border: 12
  padding: 8

  layout:
    type: verticalBox
    fit-children: true
    spacing: 0

  UIWidget
    id: iconsPanel
    width: 30
    layout:
      type: verticalBox
      fit-children: true
      spacing: 4
      padding: 0


SpecialConditionIcon < UIWidget
  width: 18
  height: 18
  phantom: true
  padding: 0
